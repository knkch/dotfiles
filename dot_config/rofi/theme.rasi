/* Awesome の配色 (modules/theme.lua) に合わせた rofi のテーマ */
* {
    base:    #1e1e2e;
    surface: #313244;
    overlay: #45475a;
    text:    #cdd6f4;
    subtext: #7f849c;
    accent:  #1e66f5;
    sky:     #89b4fa;
    urgent:  #f38ba8;

    background-color: transparent;
    text-color:       @text;
    font:             "Hack Nerd Font 13";
}

window {
    width:            640px;
    background-color: @base;
    border:           1px;
    border-color:     @overlay;
    border-radius:    14px;
    padding:          16px;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, message, listview, mode-switcher ];
}

/* 検索欄 */
inputbar {
    background-color: @surface;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          12px;
    children:         [ textbox-search, entry ];
}
/* アプリメニューと同じ虫めがねのアイコン (モード名は下のボタンで分かる) */
textbox-search {
    str:        "󰍉";
    expand:     false;
    text-color: @sky;
}
entry {
    placeholder:       "検索...";
    placeholder-color: @subtext;
    cursor-color:      @sky;
}

message {
    background-color: @surface;
    border-radius:    10px;
    padding:          8px 14px;
}

/* 一覧 */
listview {
    lines:        10;
    columns:      1;
    spacing:      2px;
    fixed-height: true;
    scrollbar:    false;
}
element {
    padding:       8px 10px;
    spacing:       12px;
    border-radius: 8px;
}
element-icon {
    size: 28px;
}
element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
element normal.normal, element alternate.normal {
    text-color: @text;
}
element selected.normal {
    background-color: @accent;
    text-color:       #ffffff;
}
element normal.urgent, element alternate.urgent {
    text-color: @urgent;
}
element selected.urgent {
    background-color: @urgent;
    text-color:       @base;
}
element normal.active, element alternate.active {
    text-color: @sky;
}
element selected.active {
    background-color: @accent;
    text-color:       #ffffff;
}

/* 下のモード切り替え (drun / run / window) */
mode-switcher {
    spacing: 6px;
}
button {
    padding:          6px;
    border-radius:    8px;
    background-color: @surface;
    text-color:       @subtext;
}
button selected {
    background-color: @accent;
    text-color:       #ffffff;
}
