# startx (greetd → tuigreet から呼ばれる) で X を起動したときに読まれる

# システム標準の初期化 (D-Bus などの環境を整える)
if [ -d /etc/X11/xinit/xinitrc.d ]; then
    for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
        [ -x "$f" ] && . "$f"
    done
    unset f
fi
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# 日本語環境と入力メソッド (fcitx5 + Mozc)
export LANG=ja_JP.UTF-8
export LC_ALL=ja_JP.UTF-8
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx

# Qt アプリの見た目は qt5ct / qt6ct で設定する
export QT_QPA_PLATFORMTHEME=qt5ct

# systemd と D-Bus に画面の情報を渡す (キーリングやファイル選択ダイアログ用)
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
# キーリング: ログイン時に PAM が開いたものに接続する (ブラウザなどのパスワード保存先)
export $(gnome-keyring-daemon --start --components=secrets 2>/dev/null)

# 常駐アプリ
fcitx5 -d &
picom &
blueman-applet &
nm-applet &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 & # 管理者権限を求めるパスワード画面
udiskie --smart-tray &   # USB メモリなどを自動でマウント (挿している間だけトレイにアイコン)
copyq &                  # クリップボード履歴 (Super+v。トレイアイコンは出さない)
gammastep &              # 夜は画面を暖色に (Super+Shift+n で切り替え)

# 画面ロック: 9分30秒操作がないと暗くし、10分でロック。スリープ時もロック
# ロック画面は ~/.local/bin/lockscreen (背景は make-lockscreen で作る)
xset s 570 30
xss-lock -n "$HOME/.local/bin/dim-screen" --transfer-sleep-lock -- "$HOME/.local/bin/lockscreen" &

exec awesome
