# ~/.zshrc — 対話シェルの設定
# プラグインやツールは入っているものだけ読み込むので、足りなくてもエラーにはならない

#################################################### 履歴
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history          # 開いているターミナル同士で履歴を共有
setopt extended_history       # 実行した時刻も記録
setopt hist_ignore_all_dups   # 同じコマンドは古い方を消す
setopt hist_ignore_space      # 先頭にスペースを付けたコマンドは記録しない
setopt hist_reduce_blanks     # 余分な空白を詰めて記録
setopt hist_verify            # !! などで呼び出した履歴は、すぐ実行せず一度表示する

#################################################### 基本の動き
setopt auto_cd                # ディレクトリ名だけで移動
setopt auto_pushd pushd_ignore_dups  # 移動したディレクトリを覚える (cd -<Tab> で選んで戻れる)
setopt interactive_comments   # コマンドラインで # 以降をコメントにする
setopt extended_glob          # **/*.txt などの高度なワイルドカード
setopt no_beep
WORDCHARS=${WORDCHARS//[\/=]/} # Ctrl+w で / や = の手前で止める

#################################################### 補完
autoload -Uz compinit
mkdir -p ~/.cache/zsh
compinit -d ~/.cache/zsh/zcompdump

zmodload zsh/complist
zstyle ':completion:*' menu select                                  # Tab で候補を矢印キーで選ぶ
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'  # 大文字小文字を区別しない・途中一致
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}               # ls と同じ色
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}候補がありません%f'
zstyle ':completion:*' rehash true                                  # 新しく入れたコマンドもすぐ補完
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.cache/zsh/compcache
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin

#################################################### キー操作 (emacs 風)
bindkey -e
bindkey '^[[H'    beginning-of-line   # Home
bindkey '^[[F'    end-of-line         # End
bindkey '^[[1~'   beginning-of-line   # Home (tmux)
bindkey '^[[4~'   end-of-line         # End (tmux)
bindkey '^[[3~'   delete-char         # Delete
bindkey '^[[1;5D' backward-word       # Ctrl+←
bindkey '^[[1;5C' forward-word        # Ctrl+→
bindkey '^H'      backward-kill-word  # Ctrl+Backspace
bindkey -M menuselect '^[[Z' reverse-menu-complete  # 候補選択中に Shift+Tab で戻る

# Ctrl+x Ctrl+e で今の行をエディタで編集
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

#################################################### 環境変数
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R -i -M'   # 色付き表示・検索で大文字小文字を区別しない

# man を色付きで読む (bat があれば)
if (( $+commands[bat] )); then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT='-c'
fi

#################################################### エイリアス
if (( $+commands[eza] )); then
    alias ls='eza --icons=auto --group-directories-first'
    alias ll='eza -l --icons=auto --group-directories-first --git --time-style=long-iso'
    alias la='eza -la --icons=auto --group-directories-first --git --time-style=long-iso'
    alias lt='eza --tree --level=2 --icons=auto'   # ツリー表示
else
    alias ls='ls --color=auto'
    alias ll='ls -lh'
    alias la='ls -lAh'
fi
(( $+commands[bat] )) && alias cat='bat --paging=never --style=plain'  # 色付きの cat (元の cat は \cat)

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias df='df -h'
alias du='du -h'
alias free='free -h'
alias cp='cp -i'          # 上書きの前に確認
alias mv='mv -i'
alias rm='rm -I'          # 4 つ以上消すときだけ確認
alias mkdir='mkdir -p'
alias ..='cd ..'
alias ...='cd ../..'
alias v='nvim'
alias vim='nvim'                    # vim も Neovim で開く
alias music='rmpc'                  # 音楽プレーヤー
alias update='yay'                  # システム全体を更新 (公式 + AUR)
alias orphans='pacman -Qdtq'        # どこからも使われていないパッケージ

#################################################### ツール
# fzf: Ctrl+r 履歴を検索 / Ctrl+t ファイルを選ぶ / Alt+c ディレクトリに移動 / **<Tab> であいまい補完
if (( $+commands[fzf] )); then
    if (( $+commands[fd] )); then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
        export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    fi
    export FZF_DEFAULT_OPTS='--height 40% --layout reverse --border rounded --info inline
      --color=bg+:#313244,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
      --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8,border:#45475a'
    (( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
    source <(fzf --zsh)
fi

# zoxide: z <名前の一部> でよく行くディレクトリに移動 / zi で一覧から選ぶ
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# atuin: Ctrl+r で履歴を検索 (実行した場所・成否・時間も記録。fzf の Ctrl+r を置き換える)
# ↑↓ は今まで通り「入力途中の文字を含む履歴」をたどる
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow)"

# lazygit: git を画面で操作 (tmux なら Ctrl+b → g でポップアップ)
(( $+commands[lazygit] )) && alias lg='lazygit'

# Metasploit: データベース (~/.msf4/db、msfdb init で作成) が止まっていたら起動してから msfconsole を開く
if (( $+commands[msfconsole] )); then
    msfconsole() {
        pg_ctl -D ~/.msf4/db status >/dev/null 2>&1 || msfdb start >/dev/null
        command msfconsole "$@"
    }
fi

# 知らないコマンドを打ったとき、入っているパッケージを教えてくれる (pkgfile)
[[ -r /usr/share/doc/pkgfile/command-not-found.zsh ]] && source /usr/share/doc/pkgfile/command-not-found.zsh

#################################################### プラグイン (順番が大事)
# fzf-tab: Tab 補完の候補を fzf の一覧で選ぶ (入力で絞り込み、< > でグループ切替、cd はフォルダの中身をプレビュー)
# compinit の後、autosuggestions・syntax-highlighting より前に読む。更新: git -C ~/.local/share/zsh/plugins/fzf-tab pull
if [[ -r ~/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh ]] && (( $+commands[fzf] )); then
    source ~/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
    zstyle ':completion:*' menu no                      # 一覧は fzf-tab に任せる
    zstyle ':completion:*:descriptions' format '[%d]'   # グループ名を表示
    zstyle ':fzf-tab:*' use-fzf-default-opts yes        # 色などは FZF_DEFAULT_OPTS と同じ
    zstyle ':fzf-tab:*' fzf-flags --height=50%
    zstyle ':fzf-tab:*' switch-group '<' '>'
    zstyle ':fzf-tab:complete:(cd|z|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons=always --group-directories-first $realpath'
    zstyle ':fzf-tab:complete:(nvim|v|bat|cat|less):*' fzf-preview '[[ -d $realpath ]] && eza -1 --color=always --icons=always $realpath || bat --color=always --style=numbers --line-range=:100 $realpath'
    zstyle ':fzf-tab:complete:kill:argument-rest' fzf-preview 'ps -o pid,user,%cpu,%mem,cmd -p $word'
fi

# 入力中に、履歴から続きを薄く表示 (→ キーか End で確定)
if [[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# コマンドの色分け (存在しないコマンドは赤)
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ↑↓ で、入力途中の文字を含む履歴だけをたどる (色分けのあとに読む)
if [[ -r /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
    source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    bindkey '^[OA' history-substring-search-up
    bindkey '^[OB' history-substring-search-down
fi

#################################################### プロンプト
if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
else
    PROMPT='%F{blue}%~%f %(?.%F{green}.%F{red})❯%f '
fi

# 自分用の追加設定はここに (無ければ何もしない)
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
